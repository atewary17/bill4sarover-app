<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <div class="card shadow-sm">
        <div class="card-header text-white d-flex justify-content-between align-items-center" style="background-color: #2c3e50;">
          <h3 class="mb-0">Customer Details</h3>
          <% if @customer.is_guest %>
            <span class="badge bg-warning text-dark">Guest</span>
          <% end %>
        </div>
        
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-3">
              <strong class="text-muted">Name:</strong>
            </div>
            <div class="col-md-9">
              <h5 class="mb-0"><%= @customer.name %></h5>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-3">
              <strong class="text-muted">Phone:</strong>
            </div>
            <div class="col-md-9">
              <%= @customer.phone %>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-3">
              <strong class="text-muted">Email:</strong>
            </div>
            <div class="col-md-9">
              <%= @customer.email %>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-3">
              <strong class="text-muted">Is Guest:</strong>
            </div>
            <div class="col-md-9">
              <% if @customer.is_guest %>
                <span class="badge bg-success">Yes</span>
              <% else %>
                <span class="badge bg-secondary">No</span>
              <% end %>
            </div>
          </div>

          <% if @customer.is_guest && @customer.payer.present? %>
            <div class="row mb-3">
              <div class="col-md-3">
                <strong class="text-muted">Payer:</strong>
              </div>
              <div class="col-md-9">
                <div class="card bg-light">
                  <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <strong><%= @customer.payer.name %></strong><br>
                        <small class="text-muted">
                          <%= @customer.payer.phone %>
                          <% if @customer.payer.email.present? %>
                            | <%= @customer.payer.email %>
                          <% end %>
                        </small>
                      </div>
                      <%= link_to "View Payer", customer_path(@customer.payer), class: "btn btn-sm", style: "background-color: #007bff; color: white;" %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <% if @customer.guests.any? %>
            <div class="row mb-3">
              <div class="col-md-3">
                <strong class="text-muted">Guests:</strong>
              </div>
              <div class="col-md-9">
                <div class="card bg-light">
                  <div class="card-body py-2">
                    <p class="mb-2 text-muted small">This customer is the payer for <%= pluralize(@customer.guests.count, 'guest') %>:</p>
                    <ul class="list-group">
                      <% @customer.guests.each do |guest| %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div>
                            <strong><%= guest.name %></strong><br>
                            <small class="text-muted"><%= guest.phone %></small>
                          </div>
                          <%= link_to "View", customer_path(guest), class: "btn btn-sm", style: "background-color: #007bff; color: white;" %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

        </div>

        <div class="card-footer bg-white">
          <div class="d-flex gap-2 flex-wrap">
            <%= link_to "Edit this customer", edit_customer_path(@customer), class: "btn text-white", style: "background-color: #007bff;" %>
            
            <%= link_to "Back to customers", customers_path, class: "btn text-white", style: "background-color: #6c757d;" %>
            
            <%= button_to "Delete", @customer, method: :delete, 
                class: "btn text-white",
                style: "background-color: #dc3545;",
                form: { data: { turbo_confirm: "Are you sure you want to delete this customer?" } } %>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>