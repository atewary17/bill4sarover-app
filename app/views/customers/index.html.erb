<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Customers</h1>
        <%= link_to new_customer_path, class: "btn text-white", style: "background-color: #007bff;" do %>
          <i class="bi bi-plus-circle"></i> New Customer
        <% end %>
      </div>

      <!-- Customers Table Card -->
      <div class="card shadow-sm">
        <div class="card-header text-white" style="background-color: #2c3e50;">
          <h5 class="mb-0">All Customers</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table id="customers-table" class="table table-striped table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>#</th>
                  <th>Name</th>
                  <th>Phone</th>
                  <th>Email</th>
                  <th>Guest</th>
                  <th>Actions</th>
                </tr>
              </thead>

              <tbody>
                <% @customers.each_with_index do |customer, index| %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td><strong><%= customer.name %></strong></td>
                    <td><%= customer.phone %></td>
                    <td><%= customer.email %></td>
                    <td>
                      <% if customer.is_guest %>
                        <span class="badge bg-warning text-dark">Yes</span>
                      <% else %>
                        <span class="badge bg-secondary">No</span>
                      <% end %>
                    </td>
                    <td>
                      <div class="d-flex gap-1">
                        <%= link_to "View", customer, class: "badge text-white text-decoration-none", style: "background-color: #007bff; padding: 0.35rem 0.65rem; font-size: 0.75rem;" %>
                        <%= link_to "Edit", edit_customer_path(customer), class: "badge text-white text-decoration-none", style: "background-color: #28a745; padding: 0.35rem 0.65rem; font-size: 0.75rem;" %>
                        <%= button_to "Delete", customer, 
                            method: :delete, 
                            class: "badge text-white border-0",
                            style: "background-color: #dc3545; padding: 0.35rem 0.65rem; font-size: 0.75rem; cursor: pointer;",
                            form: { 
                              data: { turbo_confirm: "Are you sure you want to delete this customer?" },
                              style: "display: inline;"
                            } %>
                      </div>
                    </td>                
                    </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $('#customers-table').DataTable({
      columnDefs: [
        { orderable: false, targets: [5] } // Disable sorting on Actions column
      ],
      order: [[1, 'asc']], // Default sort by Name column
      pageLength: 25, // Show 25 entries by default
      language: {
        search: "Search customers:",
        lengthMenu: "Show _MENU_ customers per page",
        info: "Showing _START_ to _END_ of _TOTAL_ customers",
        infoEmpty: "No customers found",
        infoFiltered: "(filtered from _TOTAL_ total customers)"
      }
    });
  });
</script>