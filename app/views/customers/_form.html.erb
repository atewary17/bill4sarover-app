<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow-sm">
        <div class="card-header text-white" style="background-color: #2c3e50;">
          <h3 class="mb-0">New Customer</h3>
        </div>
        
        <div class="card-body">
          <%= form_with(model: customer, class: "needs-validation") do |form| %>
            <% if customer.errors.any? %>
              <div class="alert alert-danger" role="alert">
                <h5 class="alert-heading">
                  <%= pluralize(customer.errors.count, "error") %> prohibited this customer from being saved:
                </h5>
                <ul class="mb-0">
                  <% customer.errors.each do |error| %>
                    <li><%= error.full_message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :name, class: "form-label fw-bold" %>
              <%= form.text_field :name, class: "form-control", placeholder: "Enter customer name" %>
            </div>

            <div class="mb-3">
              <%= form.label :phone, class: "form-label fw-bold" %>
              <%= form.text_field :phone, class: "form-control", placeholder: "Enter phone number" %>
            </div>

            <div class="mb-3">
              <%= form.label :email, class: "form-label fw-bold" %>
              <%= form.email_field :email, class: "form-control", placeholder: "Enter email address" %>
            </div>

            <div class="mb-3 form-check">
              <%= form.check_box :is_guest, class: "form-check-input", id: "customer-is-guest" %>
              <label class="form-check-label fw-bold" for="customer-is-guest">
                Is Guest?
              </label>
            </div>

            <!-- Payer section (hidden by default) -->
            <div id="payer-section" 
                 class="card mb-3 shadow-sm"
                 style="display: none;">
              <div class="card-header text-white" style="background-color: #495057;">
                <h5 class="mb-0">Search for Payer</h5>
              </div>
              <div class="card-body bg-light">
                <div class="mb-3">
                  <label for="payer-search-input" class="form-label fw-bold">Payer Name or Phone</label>
                  <input type="text"
                         id="payer-search-input"
                         class="form-control"
                         placeholder="Type name or phone number...">
                  <div class="form-text">Type at least 2 characters to search</div>
                </div>

                <%= form.hidden_field :payer_id, id: "payer-id-hidden" %>

                <ul id="payer-results" 
                    class="list-group"
                    style="max-height: 250px; overflow-y: auto;"></ul>
              </div>
            </div>

            <div class="d-grid gap-2">
              <%= form.submit class: "btn btn-lg text-white", style: "background-color: #007bff;" %>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="mt-3">
        <%= link_to "Back to customers", customers_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", initializeForm);
  document.addEventListener("turbo:load", initializeForm);

  function initializeForm() {
    console.log("Initializing form...");
    
    const checkbox = document.getElementById("customer-is-guest");
    const payerSection = document.getElementById("payer-section");
    const searchInput = document.getElementById("payer-search-input");
    const resultsContainer = document.getElementById("payer-results");
    const hiddenField = document.getElementById("payer-id-hidden");

    // Toggle payer section
    if (checkbox && payerSection) {
      payerSection.style.display = checkbox.checked ? "block" : "none";

      checkbox.addEventListener("change", function () {
        console.log("Checkbox changed to:", this.checked);
        payerSection.style.display = this.checked ? "block" : "none";
        
        if (!this.checked) {
          searchInput.value = "";
          hiddenField.value = "";
          resultsContainer.innerHTML = "";
        }
      });
    }

    // Autocomplete search
    if (searchInput) {
      let searchTimeout;
      
      searchInput.addEventListener("input", function () {
        const query = this.value;
        console.log("Search input:", query);
        
        // Clear previous timeout
        clearTimeout(searchTimeout);
        
        // Clear results if query is too short
        if (query.length < 2) {
          resultsContainer.innerHTML = "";
          return;
        }
        
        // Debounce search
        searchTimeout = setTimeout(() => {
          console.log("Searching for:", query);
          
          fetch(`/customers/search?q=${encodeURIComponent(query)}`)
            .then(response => {
              console.log("Response status:", response.status);
              return response.json();
            })
            .then(data => {
              console.log("Search results:", data);
              displayResults(data);
            })
            .catch(error => {
              console.error("Search error:", error);
              resultsContainer.innerHTML = '<li class="list-group-item list-group-item-danger">Error searching customers</li>';
            });
        }, 300);
      });
    }

    function displayResults(customers) {
      if (customers.length === 0) {
        resultsContainer.innerHTML = '<li class="list-group-item text-muted">No customers found</li>';
        return;
      }

      resultsContainer.innerHTML = customers.map(customer => {
        const escapedName = escapeHtml(customer.name || '');
        const escapedPhone = escapeHtml(customer.phone || '');
        
        return `
          <li class="list-group-item list-group-item-action"
              style="cursor: pointer;"
              onclick="selectCustomer(${customer.id}, '${escapedName}', '${escapedPhone}')">
            <strong>${escapedName}</strong><br>
            <small class="text-muted">${escapedPhone}</small>
          </li>
        `;
      }).join('');
    }

    // Escape HTML to prevent XSS
    function escapeHtml(text) {
      const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      };
      return String(text).replace(/[&<>"']/g, m => map[m]);
    }

    // Make selectCustomer globally accessible
    window.selectCustomer = function(id, name, phone) {
      console.log("Selected:", { id, name, phone });
      hiddenField.value = id;
      searchInput.value = `${name} (${phone})`;
      resultsContainer.innerHTML = `
        <li class="list-group-item list-group-item-success">
          ✓ Selected: <strong>${name}</strong>
        </li>
      `;
    };
  }
</script>