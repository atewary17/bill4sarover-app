<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : current_user.organization.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- jQuery (for DataTables only) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/v/dt/dt-2.3.7/datatables.min.js"></script>

    <!-- Highcharts -->
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/accessibility.js"></script>

    <!-- Rails -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "login", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "booking", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload", defer: true %>
    <%= javascript_importmap_tags %>

    <style>
      :root {
        --brand-dark:  #2c3e50;
        --brand-mid:   #34495e;
        --brand-accent:#3498db;
      }

      /* ── Navbar ──────────────────────────────────────── */
      .app-navbar {
        background-color: var(--brand-dark);
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 60px;
        box-shadow: 0 2px 6px rgba(0,0,0,.3);
        position: sticky;
        top: 0;
        z-index: 1030;
      }

      .app-navbar .brand {
        color: #fff;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: .5px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: .5rem;
      }

      .app-navbar .brand:hover { color: #ecf0f1; }

      /* Nav links */
      .app-navbar nav {
        display: flex;
        align-items: center;
        gap: .25rem;
      }

      .app-navbar nav a,
      .app-navbar nav .logout-btn {
        color: rgba(255,255,255,.82);
        font-size: .9rem;
        font-weight: 500;
        padding: .45rem .85rem;
        border-radius: 6px;
        text-decoration: none;
        transition: background .18s, color .18s;
        white-space: nowrap;
      }

      .app-navbar nav a:hover {
        background: rgba(255,255,255,.12);
        color: #fff;
      }

      .app-navbar nav a.active {
        background: var(--brand-accent);
        color: #fff;
      }

      /* User info */
      .user-info {
        color: rgba(255,255,255,.7);
        font-size: .85rem;
        padding: .45rem .85rem;
        display: flex;
        align-items: center;
        gap: .5rem;
      }

      .user-info .user-name {
        color: #fff;
        font-weight: 600;
      }

      .user-info .user-role {
        background: rgba(255,255,255,.15);
        padding: .15rem .5rem;
        border-radius: 12px;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .3px;
      }

      /* Logout button — strip form/button defaults */
      .app-navbar nav form { 
        margin: 0;
        display: inline-block;
      }
      
      .app-navbar nav .logout-btn {
        background: transparent;
        border: 1px solid rgba(255,255,255,.35);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
      }
      
      .app-navbar nav .logout-btn:hover {
        background: rgba(231,76,60,.75);
        border-color: transparent;
        color: #fff;
      }

      /* Divider pip between groups */
      .nav-divider {
        width: 1px;
        height: 22px;
        background: rgba(255,255,255,.2);
        margin: 0 .35rem;
      }

      /* ── Main content ────────────────────────────────── */
      body {
        background-color: #f4f6f9;
        min-height: 100vh;
      }

      .app-main {
        padding-top: 1.75rem;
        padding-bottom: 2.5rem;
      }

      /* ── Flash messages ──────────────────────────────── */
      .flash-wrapper {
        position: fixed;
        top: 70px;
        right: 1.25rem;
        z-index: 1055;
        display: flex;
        flex-direction: column;
        gap: .5rem;
        max-width: 360px;
      }
    </style>
  </head>

  <body>

    <!-- ── Top Navbar ── -->
    <header class="app-navbar">
      <%= link_to root_path, class: "brand" do %>
        <i class="bi bi-building"></i>
        <%= current_user.organization.name %>
      <% end %>

      <% if user_signed_in? %>
        <nav>
          <%= link_to root_path,
                class: "#{current_page?(root_path) ? 'active' : ''}" do %>
            <i class="bi bi-speedometer2"></i> Dashboard
          <% end %>

          <%= link_to customers_path,
                class: "#{controller_name == 'customers' ? 'active' : ''}" do %>
            <i class="bi bi-people"></i> Customers
          <% end %>

          <%= link_to bookings_path,
                class: "#{controller_name == 'bookings' ? 'active' : ''}" do %>
            <i class="bi bi-calendar-check"></i> Bookings
          <% end %>

          <%= link_to invoices_path,
                class: "#{controller_name == 'invoices' ? 'active' : ''}" do %>
            <i class="bi bi-receipt"></i> Invoices
          <% end %>

          <% if current_user.super_admin? %>
            <%= link_to organizations_path,
                  class: "#{controller_name == 'organizations' ? 'active' : ''}" do %>
              <i class="bi bi-building"></i> Organizations
            <% end %>
          <% end %>

          <% if current_user.can_manage_rooms? %>
            <%= link_to rooms_path,
                  class: "#{controller_name == 'rooms' ? 'active' : ''}" do %>
              <i class="bi bi-door-open"></i> Rooms
            <% end %>
          <% end %>

          <% if current_user.can_manage_users? %>
            <%= link_to users_path,
                  class: "#{controller_name == 'users' ? 'active' : ''}" do %>
              <i class="bi bi-person-gear"></i> Users
            <% end %>
          <% end %>

          <span class="nav-divider"></span>

          <!-- User Info -->
          <div class="user-info">
            <i class="bi bi-person-circle"></i>
            <span class="user-name"><%= current_user.name %></span>
            <span class="user-role"><%= current_user.role.humanize %></span>
          </div>

          <%= form_with url: destroy_user_session_path, method: :delete, data: { turbo: false } do %>
            <%= button_tag type: "submit", class: "logout-btn" do %>
              <i class="bi bi-box-arrow-right"></i> Logout
            <% end %>
          <% end %>
        </nav>
      <% end %>
    </header>

    <!-- ── Flash notices ── -->
    <div class="flash-wrapper">
      <% flash.each do |type, message| %>
        <%
          bs_class = case type.to_s
                     when "notice"  then "success"
                     when "alert"   then "danger"
                     when "warning" then "warning"
                     else "info"
                     end
        %>
        <div class="alert alert-<%= bs_class %> alert-dismissible fade show shadow-sm mb-0" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    <!-- ── Page content ── -->
    <main class="container app-main">
      <%= yield %>
    </main>

  </body>
</html>