<div class="container mt-4">
  <div class="row">
    <div class="col-12">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Bookings</h1>
        <%= link_to new_booking_path, class: "btn text-white", style: "background-color: #007bff;" do %>
          <i class="bi bi-plus-circle"></i> New Booking
        <% end %>
      </div>

      <!-- Filter Card -->
      <div class="card mb-4 shadow-sm">
        <div class="card-header text-white" style="background-color: #2c3e50;">
          <h5 class="mb-0">Filter Bookings</h5>
        </div>
        <div class="card-body">
          <%= form_with url: bookings_path, method: :get, local: true, class: "row g-3" do %>

            <div class="col-md-4">
              <label class="form-label fw-bold">From</label>
              <%= date_field_tag :from, @from, class: "form-control" %>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-bold">To</label>
              <%= date_field_tag :to, @to, class: "form-control" %>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
              <%= submit_tag "Filter", class: "btn text-white", style: "background-color: #007bff;" %>
              <%= link_to "Reset", bookings_path, class: "btn btn-outline-secondary" %>
            </div>

          <% end %>
          
        </div>
      </div>
      <!-- Bookings Table Card -->
      <div class="card shadow-sm">
        <div class="card-header text-white d-flex justify-content-between align-items-center" 
             style="background-color: #2c3e50;">
          <h5 class="mb-0">All Bookings</h5>
          
          <!-- Generate Invoice Button -->
          <%= form_with url: new_invoice_path, method: :get, local: true, 
              id: "invoice-form", class: "mb-0" do %>
            <%= submit_tag "Generate Invoice", 
                id: "generate-invoice-btn",
                class: "btn btn-sm text-white",
                style: "background-color: #28a745;",
                disabled: true,
                data: { confirm: "Generate invoice for selected bookings?" } %>
          <% end %>
        </div>

        <div class="card-body p-0">
          <div class="table-responsive">
            <table id="bookings-table" class="table table-striped table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th style="width: 40px;">
                    <input type="checkbox" id="select-all" class="form-check-input">
                  </th>
                  <th>Customer</th>
                  <th>Room</th>
                  <th>Check In</th>
                  <th>Check Out</th>
                  <th>Guests</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>

              <tbody>
                <% @bookings.each do |b| %>
                  <tr>
                    <td>
                      <%= check_box_tag "booking_ids[]", 
                          b.id, 
                          false, 
                          class: "booking-checkbox form-check-input",
                          form: "invoice-form",
                          data: { 
                            status: b.status,
                            can_invoice: b.checked_out? || b.booked? || b.checked_in?
                          },
                          disabled: b.invoiced? || b.cancelled? %>
                    </td>
                    <td><strong><%= b.customer.name %></strong></td>
                    <td>
                      <% if b.room.present? %>
                        <span class="badge bg-secondary"><%= b.room.room_number %></span>
                      <% else %>
                        <span class="text-muted">Banquet</span>
                      <% end %>
                    </td>
                    <td><%= b.check_in.strftime("%d %b %Y %H:%M") %></td>
                    <td><%= b.check_out.strftime("%d %b %Y %H:%M") %></td>
                    <td><%= b.adults + b.children %></td>
                    <td>
                      <span class="badge 
                        <%= case b.status
                          when "booked"      then "bg-primary"
                          when "checked_in"  then "bg-success"
                          when "checked_out" then "bg-secondary"
                          when "cancelled"   then "bg-danger"
                          when "invoiced"    then "bg-info"
                        end %>">
                        <%= b.status.humanize %>
                      </span>
                    </td>
                    <td>
                      <%= link_to "View", booking_path(b), 
                          class: "badge text-white text-decoration-none",
                          style: "background-color: #007bff; padding: 0.35rem 0.65rem; font-size: 0.75rem;" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    
    // Initialize DataTable
    const table = $('#bookings-table').DataTable({
      columnDefs: [
        { orderable: false, targets: [0, 5, 7] }
      ],
      order: [[3, 'desc']], // Sort by Check In date descending
      pageLength: 25,
      language: {
        search:       "Search bookings:",
        lengthMenu:   "Show _MENU_ bookings per page",
        info:         "Showing _START_ to _END_ of _TOTAL_ bookings",
        infoEmpty:    "No bookings found",
        infoFiltered: "(filtered from _TOTAL_ total bookings)"
      }
    });

    const generateBtn = $('#generate-invoice-btn');

    // Validate and toggle Generate Invoice button
    function validateInvoiceButton() {
      const checkedBoxes = $('.booking-checkbox:checked');
      const validBoxes = checkedBoxes.filter(function() {
        return $(this).data('can-invoice') === true;
      });

      if (validBoxes.length > 0) {
        generateBtn.prop('disabled', false);
        generateBtn.removeClass('btn-secondary').css('background-color', '#28a745');
      } else {
        generateBtn.prop('disabled', true);
        generateBtn.addClass('btn-secondary').css('background-color', '');
      }

      // Show warning if invalid bookings selected
      const invalidBoxes = checkedBoxes.filter(function() {
        return $(this).data('can-invoice') === false;
      });

      if (invalidBoxes.length > 0) {
        const statuses = invalidBoxes.map(function() {
          return $(this).data('status');
        }).get().join(', ');
        
        console.warn(`Cannot invoice bookings with status: ${statuses}`);
      }
    }

    // Select/Deselect All (only enabled checkboxes)
    $('#select-all').on('click', function() {
      const isChecked = this.checked;
      $('.booking-checkbox:not(:disabled)').prop('checked', isChecked);
      validateInvoiceButton();
    });

    // Individual checkbox change
    $('.booking-checkbox').on('change', function() {
      validateInvoiceButton();
      
      // Update "select all" state
      const total = $('.booking-checkbox:not(:disabled)').length;
      const checked = $('.booking-checkbox:checked:not(:disabled)').length;
      $('#select-all').prop('checked', total === checked && total > 0);
    });

    // Prevent form submission with invalid bookings
    $('#invoice-form').on('submit', function(e) {
      const checkedBoxes = $('.booking-checkbox:checked');
      const invalidBoxes = checkedBoxes.filter(function() {
        return $(this).data('can-invoice') === false;
      });

      if (invalidBoxes.length > 0) {
        e.preventDefault();
        alert('Cannot generate invoice for cancelled or already invoiced bookings. Please deselect them.');
        return false;
      }

      if (checkedBoxes.length === 0) {
        e.preventDefault();
        alert('Please select at least one booking to generate an invoice.');
        return false;
      }
    });

    // Initial validation
    validateInvoiceButton();
  });
</script>