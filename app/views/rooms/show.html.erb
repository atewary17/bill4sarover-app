<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      
      <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
          <h1 class="mb-1"><%= @room.room_number %></h1>
          <div class="d-flex align-items-center gap-3 mb-2">
            <span class="badge fs-6 <%= @room.status == 'available' ? 'bg-success' : 'bg-warning' %>">
              <%= @room.status.humanize %>
            </span>
            <span class="badge bg-secondary fs-6"><%= @room.room_type.gsub('_', ' ').titleize %></span>
          </div>
          <small class="text-muted">
            <i class="bi bi-building me-1"></i>
            <%= current_organization.name %>
          </small>
        </div>
        
        <div class="text-end">
          <%= link_to edit_room_path(@room), class: "btn btn-outline-primary me-2" do %>
            <i class="bi bi-pencil"></i> Edit
          <% end %>
          <%= link_to rooms_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-arrow-left"></i> Back
          <% end %>
        </div>
      </div>

      <div class="row g-4">
        <!-- Main Details -->
        <div class="col-lg-8">
          <div class="card shadow-sm h-100">
            <div class="card-header bg-light border-0 pb-0">
              <h5 class="mb-2">
                <i class="bi bi-info-circle me-2 text-muted"></i>
                Room Details
              </h5>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="fw-semibold text-muted">Room Number</label>
                  <h4 class="mb-0"><%= @room.room_number %></h4>
                </div>
                <div class="col-md-6">
                  <label class="fw-semibold text-muted">Room Type</label>
                  <p class="mb-0 fs-5"><%= @room.room_type.gsub('_', ' ').titleize %></p>
                </div>
                <div class="col-md-6">
                  <label class="fw-semibold text-muted">Base Price/Night</label>
                  <h4 class="text-success mb-0">
                    ₹<%= number_with_precision(@room.base_price_per_night, precision: 2, delimiter: ',') %>
                  </h4>
                </div>
                <div class="col-md-6">
                  <label class="fw-semibold text-muted">Status</label>
                  <span class="badge fs-5 <%= @room.status == 'available' ? 'bg-success' : 'bg-warning' %>">
                    <%= @room.status.humanize %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bookings Summary -->
        <div class="col-lg-4">
          <div class="card shadow-sm h-100">
            <div class="card-header bg-light border-0 pb-0">
              <h6 class="mb-2">
                <i class="bi bi-calendar-check me-2 text-muted"></i>
                Bookings (<%= @room.bookings.count %>)
              </h6>
            </div>
            <div class="card-body">
              <% if @room.bookings.any? %>
                <% @room.bookings.order(created_at: :desc).limit(5).each do |booking| %>
                  <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                      <small class="text-muted"><%= booking.customer&.name || "Guest" %></small>
                    </div>
                    <div class="text-end">
                      <small><%= booking.check_in.strftime("%b %d") %> - <%= booking.check_out.strftime("%b %d") %></small>
                    </div>
                  </div>
                <% end %>
                <% if @room.bookings.count > 5 %>
                  <small class="text-center d-block text-muted mt-2">
                    +<%= @room.bookings.count - 5 %> more...
                  </small>
                <% end %>
              <% else %>
                <div class="text-center py-4 text-muted">
                  <i class="bi bi-calendar-x fs-1 opacity-50 mb-2 d-block"></i>
                  <small>No bookings yet</small>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
