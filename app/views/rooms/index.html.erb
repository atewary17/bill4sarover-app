<div class="container mt-4">
  <div class="row">
    <div class="col-12">

      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Rooms</h1>
        <% if policy(Room).create? %>
          <%= link_to "Add Room", new_room_path, class: "btn text-white", style: "background-color: #007bff;" %>
        <% end %>
      </div>

      <div class="card shadow-sm">
        <div class="card-header text-white" style="background-color: #2c3e50;">
          <h5 class="mb-0">All Rooms</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Room Number</th>
                  <th>Type</th>
                  <th>Price/Night</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @rooms.each do |room| %>
                  <tr>
                    <td><strong><%= room.room_number %></strong></td>
                    <td><span class="badge bg-secondary"><%= room.room_type %></span></td>
                    <td>
                      <% if policy(room).update_price? %>
                        <%= form_with url: update_price_room_path(room), method: :patch, class: "d-inline-flex align-items-center gap-2" do %>
                          <div class="input-group input-group-sm" style="width: 150px;">
                            <span class="input-group-text">₹</span>
                            <%= number_field_tag :base_price_per_night, 
                                room.base_price_per_night, 
                                class: "form-control form-control-sm",
                                step: 0.01,
                                min: 0 %>
                          </div>
                          <%= button_tag type: "submit", class: "btn btn-sm btn-success" do %>
                            <i class="bi bi-check"></i>
                          <% end %>
                        <% end %>
                      <% else %>
                        <strong>₹<%= number_with_precision(room.base_price_per_night, precision: 2, delimiter: ',') %></strong>
                      <% end %>
                    </td>
                    <td>
                      <span class="badge <%= room.status == 'available' ? 'bg-success' : 'bg-warning' %>">
                        <%= room.status %>
                      </span>
                    </td>
                    <td>
                      <% if policy(room).update? %>
                        <%= link_to "Edit", edit_room_path(room), class: "btn btn-sm btn-outline-primary" %>
                      <% end %>
                      <% if policy(room).destroy? %>
                        <%= button_to "Delete", room_path(room),
                            method: :delete,
                            class: "btn btn-sm btn-outline-danger",
                            data: { confirm: "Delete room #{room.room_number}?" } %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>