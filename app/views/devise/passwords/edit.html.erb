<div class="login-wrapper">
  <div class="login-card">
    <h2>Reset Your Password</h2>
    <p class="subtitle">Enter your new password below</p>

    <%= form_for(resource, as: resource_name, url: user_password_path, html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <%= f.label :password, "New password" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "Enter new password" %>
        <% if @minimum_password_length %>
          <small class="form-text text-muted">
            (<%= @minimum_password_length %> characters minimum)
          </small>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirm new password" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password" %>
      </div>

      <div class="actions">
        <%= f.submit "Change My Password", class: "btn-primary" %>
      </div>
    <% end %>

    <div class="links">
      <%= link_to "Back to Login", new_user_session_path %>
    </div>
  </div>
</div>