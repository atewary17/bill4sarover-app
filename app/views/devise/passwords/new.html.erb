<div class="login-wrapper">
  <div class="login-card">
    <h2>Forgot Password?</h2>
    <p class="subtitle">Enter your email to reset your password</p>

    <%= form_for(resource, as: resource_name, url: user_password_path, html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "your@email.com" %>
      </div>

      <div class="actions">
        <%= f.submit "Send Reset Instructions", class: "btn-primary" %>
      </div>
    <% end %>

    <div class="links">
      <%= link_to "Back to Login", new_user_session_path %>
    </div>
  </div>
</div>