<% content_for :title, "Dashboard | Bill4Sarover" %>

<div class="container-fluid mt-4">

  <!-- Page Header with Date Filter -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Dashboard</h1>

    <!-- Auto-submit date range filter -->
    <%= form_with url: root_path, method: :get, local: true, id: "dashboard-filter" do |f| %>
      <div class="d-flex align-items-center gap-2">
        <div class="input-group input-group-sm" style="width: auto;">
          <span class="input-group-text bg-white text-muted border-end-0">
            <i class="bi bi-calendar3"></i>
          </span>
          <%= f.datetime_local_field :from,
                value: @from,
                class: "form-control form-control-sm border-start-0 ps-0",
                style: "min-width: 175px;",
                "data-auto-submit": "true" %>
        </div>

        <span class="text-muted fw-semibold">→</span>

        <div class="input-group input-group-sm" style="width: auto;">
          <span class="input-group-text bg-white text-muted border-end-0">
            <i class="bi bi-calendar3"></i>
          </span>
          <%= f.datetime_local_field :to,
                value: @to,
                class: "form-control form-control-sm border-start-0 ps-0",
                style: "min-width: 175px;",
                "data-auto-submit": "true" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- ══════════════ BOOKINGS SECTION ══════════════ -->
  <div class="mb-5">
    <h4 class="mb-3 text-muted">
      <i class="bi bi-calendar-check"></i> Bookings Overview
    </h4>

    <!-- Bookings Stats Row -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:#ebf5fb;">
              <i class="bi bi-calendar-check fs-5" style="color:#3498db;"></i>
            </div>
            <div>
              <div class="text-muted small">Total Bookings</div>
              <div class="fs-4 fw-bold"><%= @bookings.count %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:#eafaf1;">
              <i class="bi bi-door-open fs-5" style="color:#27ae60;"></i>
            </div>
            <div>
              <div class="text-muted small">Checked In</div>
              <div class="fs-4 fw-bold"><%= @bookings.where(status: :checked_in).count %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:#fef9e7;">
              <i class="bi bi-clock-history fs-5" style="color:#f39c12;"></i>
            </div>
            <div>
              <div class="text-muted small">Upcoming</div>
              <div class="fs-4 fw-bold"><%= @bookings.where(status: :booked).count %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:#fdedec;">
              <i class="bi bi-x-circle fs-5" style="color:#e74c3c;"></i>
            </div>
            <div>
              <div class="text-muted small">Cancelled</div>
              <div class="fs-4 fw-bold"><%= @bookings.where(status: :cancelled).count %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bookings Chart -->
    <div class="card shadow-sm border-0">
      <div class="card-header text-white d-flex align-items-center gap-2 py-3"
           style="background-color: #2c3e50;">
        <i class="bi bi-bar-chart-line"></i>
        <span class="fw-semibold">Bookings Over Time</span>
        <span class="text-white-50 small ms-auto">
          <%= @from.to_date.strftime("%d %b %Y") %> – <%= @to.to_date.strftime("%d %b %Y") %>
        </span>
      </div>
      <div class="card-body p-3">
        <div id="booking-chart" style="height: 380px;"></div>
      </div>
    </div>
  </div>

  <!-- ══════════════ INVOICES SECTION ══════════════ -->
  <div class="mb-5">
    <h4 class="mb-3 text-muted">
      <i class="bi bi-receipt"></i> Invoices & Revenue
    </h4>

    <!-- Invoice Stats Row -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:#e8f8f5;">
              <i class="bi bi-receipt-cutoff fs-5" style="color:#1abc9c;"></i>
            </div>
            <div>
              <div class="text-muted small">Total Invoices</div>
              <div class="fs-4 fw-bold"><%= @invoices.count %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:#eafaf1;">
              <i class="bi bi-check-circle fs-5" style="color:#27ae60;"></i>
            </div>
            <div>
              <div class="text-muted small">Paid</div>
              <div class="fs-4 fw-bold"><%= @invoices.where(status: :paid).count %></div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:#fef9e7;">
              <i class="bi bi-hourglass-split fs-5" style="color:#f39c12;"></i>
            </div>
            <div>
              <div class="text-muted small">Pending</div>
              <div class="fs-4 fw-bold">
                <%= @invoices.where(status: [:draft, :issued, :partial]).count %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:#ebf5fb;">
              <i class="bi bi-currency-rupee fs-5" style="color:#3498db;"></i>
            </div>
            <div>
              <div class="text-muted small">Total Revenue</div>
              <div class="fs-4 fw-bold">
                ₹<%= number_with_precision(@total_revenue, precision: 0, delimiter: ',') %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Revenue Breakdown Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
          <div class="card-body text-white">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="text-white-50 small">Paid Revenue</div>
                <div class="fs-3 fw-bold">
                  ₹<%= number_with_precision(@paid_revenue, precision: 2, delimiter: ',') %>
                </div>
              </div>
              <i class="bi bi-cash-stack fs-2 opacity-50"></i>
            </div>
            <small class="text-white-50">
              <%= @invoices.where(status: :paid).count %> invoices paid
            </small>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
          <div class="card-body text-white">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <div class="text-white-50 small">Pending Revenue</div>
                <div class="fs-3 fw-bold">
                  ₹<%= number_with_precision(@pending_revenue, precision: 2, delimiter: ',') %>
                </div>
              </div>
              <i class="bi bi-clock-history fs-2 opacity-50"></i>
            </div>
            <small class="text-white-50">
              <%= @invoices.where(status: [:draft, :issued, :partial]).count %> invoices pending
            </small>
          </div>
        </div>
      </div>
    </div>

    <!-- Invoice Chart -->
    <div class="card shadow-sm border-0">
      <div class="card-header text-white d-flex align-items-center gap-2 py-3"
           style="background-color: #2c3e50;">
        <i class="bi bi-graph-up"></i>
        <span class="fw-semibold">Invoices Over Time</span>
        <span class="text-white-50 small ms-auto">
          <%= @from.to_date.strftime("%d %b %Y") %> – <%= @to.to_date.strftime("%d %b %Y") %>
        </span>
      </div>
      <div class="card-body p-3">
        <div id="invoice-chart" style="height: 380px;"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    // ── Auto-submit on date change ──
    document.querySelectorAll("[data-auto-submit='true']").forEach(function (input) {
      input.addEventListener("change", function () {
        document.getElementById("dashboard-filter").submit();
      });
    });

    // ── Highcharts Guard ──
    if (typeof Highcharts !== "object") {
      console.error("Highcharts not loaded");
      return;
    }

    // ── Bookings Chart ──
    const bookingData       = <%= raw @booking_counts.to_json %>;
    const bookingCategories = Object.keys(bookingData);
    const bookingValues     = Object.values(bookingData);

    Highcharts.chart('booking-chart', {
      chart: {
        type: 'column',
        style: { fontFamily: 'inherit' },
        backgroundColor: 'transparent'
      },
      title:    { text: null },
      xAxis:    { categories: bookingCategories, crosshair: true },
      yAxis:    { allowDecimals: false, title: { text: 'Bookings' } },
      tooltip:  { headerFormat: '<b>{point.key}</b><br>', pointFormat: '{series.name}: {point.y}' },
      plotOptions: {
        column: {
          borderRadius: 4,
          color: '#3498db'
        }
      },
      series:  [{ name: 'Bookings', data: bookingValues }],
      credits: { enabled: false },
      legend:  { enabled: false }
    });

    // ── Invoices Chart ──
    const invoiceData       = <%= raw @invoice_counts.to_json %>;
    const invoiceCategories = Object.keys(invoiceData);
    const invoiceValues     = Object.values(invoiceData);

    Highcharts.chart('invoice-chart', {
      chart: {
        type: 'area',
        style: { fontFamily: 'inherit' },
        backgroundColor: 'transparent'
      },
      title:    { text: null },
      xAxis:    { categories: invoiceCategories, crosshair: true },
      yAxis:    { allowDecimals: false, title: { text: 'Invoices' } },
      tooltip:  { 
        headerFormat: '<b>{point.key}</b><br>', 
        pointFormat: '{series.name}: {point.y}'
      },
      plotOptions: {
        area: {
          fillColor: {
            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
            stops: [
              [0, 'rgba(26, 188, 156, 0.5)'],
              [1, 'rgba(26, 188, 156, 0.05)']
            ]
          },
          marker: {
            radius: 4
          },
          lineWidth: 2,
          lineColor: '#1abc9c',
          states: {
            hover: {
              lineWidth: 2
            }
          },
          threshold: null
        }
      },
      series:  [{ name: 'Invoices', data: invoiceValues }],
      credits: { enabled: false },
      legend:  { enabled: false }
    });
  });
</script>