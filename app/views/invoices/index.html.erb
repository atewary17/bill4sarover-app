<div class="container mt-4">
  <div class="row">
    <div class="col-12">

      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Invoices</h1>
        <%= link_to new_invoice_path, class: "btn text-white", style: "background-color: #007bff;" do %>
          + New Invoice
        <% end %>
      </div>

      <!-- Filter Card -->
      <div class="card mb-4 shadow-sm">
        <div class="card-header text-white" style="background-color: #2c3e50;">
          <h5 class="mb-0">Filter Invoices</h5>
        </div>
        <div class="card-body">
          <%= form_with url: invoices_path, method: :get, local: true, class: "row g-3" do %>

            <div class="col-md-4">
              <label class="form-label fw-bold">From</label>
              <%= date_field_tag :from, @from, class: "form-control" %>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-bold">To</label>
              <%= date_field_tag :to, @to, class: "form-control" %>
            </div>

            <div class="col-md-4 d-flex align-items-end gap-2">
              <%= submit_tag "Filter", class: "btn text-white", style: "background-color: #007bff;" %>
              <%= link_to "Reset", invoices_path, class: "btn btn-outline-secondary" %>
            </div>

          <% end %>
          
          <div class="col-12 mt-2">
            <small class="text-muted">
              <i class="bi bi-info-circle"></i>
              Showing invoices from <%= @from.strftime("%d %b %Y") %> to <%= @to.strftime("%d %b %Y") %>
            </small>
          </div>
        </div>
      </div>

      <!-- Invoices Table Card -->
      <div class="card shadow-sm">
        <div class="card-header text-white" style="background-color: #2c3e50;">
          <h5 class="mb-0">All Invoices (<%= @invoices.count %>)</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table id="invoices-table" class="table table-striped table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Invoice #</th>
                  <th>Billed To</th>
                  <th>Rooms</th>
                  <th>Issued At</th>
                  <th>Due Date</th>
                  <th>Total</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @invoices.each do |invoice| %>
                  <tr>
                    <td><strong><%= invoice.invoice_number %></strong></td>
                    <td>
                      <strong><%= invoice.billed_to_name.presence || "—" %></strong>
                      <% if invoice.billed_to_phone.present? %>
                        <br><small class="text-muted"><%= invoice.billed_to_phone %></small>
                      <% end %>
                    </td>
                    <td>
                      <%
                        room_numbers = invoice.invoice_items
                          .select { |i| i.metadata&.dig("type") == "booking" }
                          .map    { |i| i.metadata&.dig("room_number") }
                          .compact.uniq
                      %>
                      <% if room_numbers.any? %>
                        <% room_numbers.each do |room| %>
                          <span class="badge bg-secondary me-1"><%= room %></span>
                        <% end %>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                    <td>
                      <%= invoice.issued_at&.strftime("%d %b %Y") || "—" %>
                    </td>
                    <td>
                      <% if invoice.due_date.present? %>
                        <% overdue = invoice.due_date < Date.today && !['paid', 'void'].include?(invoice.status) %>
                        <span class="<%= overdue ? 'text-danger fw-bold' : '' %>">
                          <%= invoice.due_date.strftime("%d %b %Y") %>
                          <% if overdue %><br><small>Overdue</small><% end %>
                        </span>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                    <td>
                      <strong>₹<%= number_with_precision(invoice.total_amount, precision: 2, delimiter: ',') %></strong>
                    </td>
                    <td>
                      <span class="badge
                        <%= case invoice.status
                          when 'draft'   then 'bg-secondary'
                          when 'issued'  then 'bg-primary'
                          when 'partial' then 'bg-warning text-dark'
                          when 'paid'    then 'bg-success'
                          when 'void'    then 'bg-danger'
                        end %>">
                        <%= invoice.status.humanize %>
                      </span>
                    </td>
                    <td>
                      <%= link_to "View", invoice_path(invoice),
                          class: "badge text-white text-decoration-none",
                          style: "background-color: #007bff; padding: 0.35rem 0.65rem; font-size: 0.75rem;" %>
                      <%= link_to "Edit", edit_invoice_path(invoice),
                          class: "badge text-decoration-none",
                          style: "background-color: #e9ecef; color: #2c3e50; padding: 0.35rem 0.65rem; font-size: 0.75rem;" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $('#invoices-table').DataTable({
      order: [[3, 'desc']],
      columnDefs: [{ orderable: false, targets: [2, 7] }],
      pageLength: 25,
      language: {
        search:       "Search invoices:",
        lengthMenu:   "Show _MENU_ invoices per page",
        info:         "Showing _START_ to _END_ of _TOTAL_ invoices",
        infoEmpty:    "No invoices found",
        infoFiltered: "(filtered from _TOTAL_ total invoices)"
      }
    });
  });
</script>